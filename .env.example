# Copy to .env.local and fill in. Never commit real values.

# Public URL of the site (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon Postgres — Neon console → Connection Details (or run `neon env pull`).
# Server only. Never expose to the browser.
DATABASE_URL=
# Direct (unpooled) connection, used by `npm run db:migrate`.
DATABASE_URL_UNPOOLED=

# Neon Auth (Managed Better Auth) — Neon console → Auth.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Order emails (see docs/ORDERS-AND-PAYMENTS.md). No online payments are taken.
# Sender for order emails. Must be on a domain verified in Resend, e.g. "Heaven Reptiles <orders@yourdomain.com>".
# Until you verify a domain, leave empty to use Resend's test sender (it can only email your own Resend account address).
ORDER_FROM_EMAIL=
# Where customer replies go (your inbox)
ORDER_REPLY_TO_EMAIL=
# Where "New order" notifications go (your inbox)
ORDER_NOTIFICATION_EMAIL=
# Protects /api/cron/orders (payment reminders + releasing unpaid orders). Any long random string.
CRON_SECRET=

# Resend — transactional email
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "Heaven Reptiles <orders@yourdomain.com>"
EMAIL_FROM=
# Where contact form messages are delivered
CONTACT_INBOX_EMAIL=

# Cloudflare Turnstile — https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Secret used to sign the guest cart cookie (any long random string: `openssl rand -hex 32`)
CART_COOKIE_SECRET=

# Optional: Upstash Redis for rate limiting. Falls back to a Supabase-backed limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: image search for `npm run fetch:images` (Wikimedia Commons needs no key)
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# Shared secret for POST /api/revalidate (used by the product sync GitHub Action)
REVALIDATE_SECRET=

# Neon Object Storage (S3-compatible) — image uploads in /admin.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
