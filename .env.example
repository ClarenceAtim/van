# Copy to .env.local and fill in. Never commit real values.

# Public URL of the site (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Used by `npm run db:types`
SUPABASE_PROJECT_ID=

# Stripe — Developers → API keys (use sk_test_… until launch)
STRIPE_SECRET_KEY=
# Developers → Webhooks → signing secret (whsec_…)
STRIPE_WEBHOOK_SECRET=

# Resend — transactional email
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "ScaleHaven Reptiles <orders@yourdomain.com>"
EMAIL_FROM=
# Where contact form messages are delivered
CONTACT_INBOX_EMAIL=

# Cloudflare Turnstile — https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Secret used to sign the guest cart cookie (any long random string: `openssl rand -hex 32`)
CART_COOKIE_SECRET=

# Optional: Upstash Redis for rate limiting. Falls back to a Supabase-backed limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: image search for `npm run fetch:images` (Wikimedia Commons needs no key)
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# Shared secret for POST /api/revalidate (used by the product sync GitHub Action)
REVALIDATE_SECRET=

# Set to "true" after enabling CAPTCHA (Turnstile) in Supabase Auth → Attack Protection
SUPABASE_AUTH_CAPTCHA=false
